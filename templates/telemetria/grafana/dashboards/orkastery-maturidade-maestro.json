        "targets": [{ "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "editorMode": "code", "expr": "sum by (event_name, user_hash, service_namespace) (count_over_time({service_name=\"orkastery\"} | json | event_name=~\"orkastery\\.ledger\\.ship_done|orkastery\\.ledger\\.verify_run\" | user_hash=~\"${user_hash:regex}\" | service_namespace=~\"${service_namespace:regex}\" [$__interval]))", "legendFormat": "agent.merge_receipt_coverage · {{event_name}} · {{user_hash}} · {{service_namespace}}", "queryType": "range" }]
