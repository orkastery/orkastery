        "targets": [{ "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "editorMode": "code", "expr": "sum by (event_name, user_hash, service_namespace, orkastery_thread_id) (count_over_time({service_name=\"orkastery\"} | json | event_name=~\"orkastery\\.ledger\\.go_fix_opened|orkastery\\.ledger\\.check_reverify\" | user_hash=~\"${user_hash:regex}\" | service_namespace=~\"${service_namespace:regex}\" [$__interval]))", "legendFormat": "agent.check_rework · {{event_name}} · {{user_hash}} · {{service_namespace}} · {{orkastery_thread_id}}", "queryType": "range" }]
