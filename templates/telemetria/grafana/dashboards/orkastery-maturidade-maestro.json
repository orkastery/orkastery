      { "id": 11, "type": "timeseries", "title": "Change fail rate", "gridPos": { "h": 7, "w": 8, "x": 16, "y": 26 }, "fieldConfig": { "defaults": {}, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom" } }, "targets": [{ "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "editorMode": "code", "expr": "sum by (event_name, service_name, service_namespace) (count_over_time({service_name!=\"\"} | json | event_name=~\"orkastery\\.sdlc\\.deployment\\.v1|orkastery\\.sdlc\\.incident\\.v1\" | service_namespace=~\"${service_namespace:regex}\" [$__interval]))", "legendFormat": "change_fail_rate · {{event_name}} · {{service_name}} · {{service_namespace}}", "queryType": "range" }] },
      { "id": 12, "type": "timeseries", "title": "Failed deployment recovery time", "gridPos": { "h": 7, "w": 12, "x": 0, "y": 33 }, "fieldConfig": { "defaults": {}, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom" } }, "targets": [{ "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "editorMode": "code", "expr": "sum by (event_name, service_name, service_namespace) (count_over_time({service_name!=\"\"} | json | event_name=~\"orkastery\\.sdlc\\.incident\\.v1\" | service_namespace=~\"${service_namespace:regex}\" [$__interval]))", "legendFormat": "failed_deployment_recovery_time · {{event_name}} · {{service_name}} · {{service_namespace}}", "queryType": "range" }] },
      { "id": 13, "type": "timeseries", "title": "Deployment rework rate", "gridPos": { "h": 7, "w": 12, "x": 12, "y": 33 }, "fieldConfig": { "defaults": {}, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom" } }, "targets": [{ "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "editorMode": "code", "expr": "sum by (event_name, service_name, service_namespace) (count_over_time({service_name!=\"\"} | json | event_name=~\"orkastery\\.sdlc\\.deployment\\.v1|orkastery\\.sdlc\\.incident\\.v1\" | service_namespace=~\"${service_namespace:regex}\" [$__interval]))", "legendFormat": "deployment_rework_rate · {{event_name}} · {{service_name}} · {{service_namespace}}", "queryType": "range" }] }
