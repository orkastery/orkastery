{
  "$ref": "#/definitions/CodeArtifactGraph",
  "definitions": {
    "CodeArtifactGraph": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "ork.code-artifact-graph/v1"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "repository_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "snapshot_id": {
              "type": "string",
              "pattern": "^snap-[a-f0-9]{64}$"
            },
            "revision": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "revision_unavailable_reason": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_manifest": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "authority": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9+.-]{0,31}:[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
                  },
                  "source_hash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "source_version": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "access": {
                    "type": "object",
                    "properties": {
                      "tenant_id": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
                      },
                      "acl_refs": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
                        },
                        "minItems": 1,
                        "maxItems": 32
                      }
                    },
                    "required": [
                      "tenant_id",
                      "acl_refs"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "path",
                  "authority",
                  "source_hash",
                  "source_version",
                  "size_bytes",
                  "access"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 100000
            },
            "config_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "extractors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "extractor_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9._-]{0,63}$"
                  },
                  "extractor_version": {
                    "type": "string",
                    "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]{0,63}$"
                  }
                },
                "required": [
                  "extractor_id",
                  "extractor_version"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 32
            },
            "extractors_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "snapshot_id",
            "revision",
            "revision_unavailable_reason",
            "source_manifest",
            "config_hash",
            "extractors",
            "extractors_digest"
          ],
          "additionalProperties": false
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node_id": {
                "type": "string",
                "pattern": "^node-[a-f0-9]{64}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "file",
                  "symbol",
                  "section",
                  "artifact"
                ]
              },
              "snapshot_id": {
                "type": "string",
                "pattern": "^snap-[a-f0-9]{64}$"
              },
              "locator": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "fragment": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "path",
                  "fragment"
                ],
                "additionalProperties": false
              },
              "source_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "access": {
                "type": "object",
                "properties": {
                  "tenant_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
                  },
                  "acl_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
                    },
                    "minItems": 1,
                    "maxItems": 32
                  }
                },
                "required": [
                  "tenant_id",
                  "acl_refs"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "node_id",
              "kind",
              "snapshot_id",
              "locator",
              "source_hash",
              "access"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "edge_id": {
                "type": "string",
                "pattern": "^edge-[a-f0-9]{64}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "contains",
                  "declares",
                  "imports",
                  "calls",
                  "references",
                  "derived_from"
                ]
              },
              "snapshot_id": {
                "type": "string",
                "pattern": "^snap-[a-f0-9]{64}$"
              },
              "from": {
                "type": "string",
                "pattern": "^node-[a-f0-9]{64}$"
              },
              "to": {
                "type": "string",
                "pattern": "^node-[a-f0-9]{64}$"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "snapshot_id": {
                      "type": "string",
                      "pattern": "^snap-[a-f0-9]{64}$"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "source_hash": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "source_version": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"
                    },
                    "authority": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9+.-]{0,31}:[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
                    },
                    "extractor_id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
                    },
                    "extractor_version": {
                      "type": "string",
                      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]{0,63}$"
                    },
                    "extraction_method": {
                      "type": "string",
                      "enum": [
                        "ast",
                        "structured",
                        "explicit-link",
                        "text-location"
                      ]
                    },
                    "confidence_class": {
                      "type": "string",
                      "const": "EXTRACTED"
                    },
                    "span": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "text"
                            },
                            "byte_start": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "byte_end": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "line_start": {
                              "anyOf": [
                                {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 9007199254740991
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "line_end": {
                              "anyOf": [
                                {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 9007199254740991
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "required": [
                            "type",
                            "byte_start",
                            "byte_end",
                            "line_start",
                            "line_end"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "pdf-text"
                            },
                            "page": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 100000
                            },
                            "byte_start": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "byte_end": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "extracted_text_hash": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            }
                          },
                          "required": [
                            "type",
                            "page",
                            "byte_start",
                            "byte_end",
                            "extracted_text_hash"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "access": {
                      "type": "object",
                      "properties": {
                        "tenant_id": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
                        },
                        "acl_refs": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
                          },
                          "minItems": 1,
                          "maxItems": 32
                        }
                      },
                      "required": [
                        "tenant_id",
                        "acl_refs"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "snapshot_id",
                    "path",
                    "source_hash",
                    "source_version",
                    "authority",
                    "extractor_id",
                    "extractor_version",
                    "extraction_method",
                    "confidence_class",
                    "span",
                    "access"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 64
              },
              "access": {
                "type": "object",
                "properties": {
                  "tenant_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
                  },
                  "acl_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
                    },
                    "minItems": 1,
                    "maxItems": 32
                  }
                },
                "required": [
                  "tenant_id",
                  "acl_refs"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "edge_id",
              "kind",
              "snapshot_id",
              "from",
              "to",
              "evidence",
              "access"
            ],
            "additionalProperties": false
          },
          "maxItems": 500000
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "unresolved-import",
                  "dynamic-resolution",
                  "unsupported-language"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "reference": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "extractor_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              },
              "extractor_version": {
                "type": "string",
                "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]{0,63}$"
              },
              "access": {
                "type": "object",
                "properties": {
                  "tenant_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
                  },
                  "acl_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
                    },
                    "minItems": 1,
                    "maxItems": 32
                  }
                },
                "required": [
                  "tenant_id",
                  "acl_refs"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "path",
              "reference",
              "extractor_id",
              "extractor_version",
              "access"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        }
      },
      "required": [
        "schema",
        "tenant_id",
        "repository_id",
        "snapshot",
        "nodes",
        "edges",
        "diagnostics"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
