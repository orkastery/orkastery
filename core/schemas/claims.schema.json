{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "tarefa": { "type": "string", "minLength": 1, "maxLength": 128 },
          "arquivo": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "alegacao": { "type": "string", "minLength": 1, "maxLength": 8192 },
          "verifyId": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "required": ["tarefa", "arquivo", "alegacao", "verifyId"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "claims"],
  "additionalProperties": false
}
