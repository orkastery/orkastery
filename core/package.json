{
  "name": "@orkastery/cli",
  "version": "0.6.1",
  "description": "A software factory of AI agents that proves its work: parallel threads, verified results, and short decisions only when they matter.",
  "license": "MIT",
  "homepage": "https://github.com/orkastery/orkastery#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orkastery/orkastery.git",
    "directory": "core"
  },
  "bugs": {
    "url": "https://github.com/orkastery/orkastery/issues"
  },
  "keywords": [
    "orkastery",
    "ork",
    "claude-code",
    "codex",
    "ai-agents",
    "agentic-coding",
    "orquestracao",
    "verification",
    "looping-threads",
    "cli",
    "ledger",
    "hitl"
  ],
  "bin": {
    "ork": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist/",
    "!dist/.tsbuildinfo",
    "assets/",
    "schemas/",
    "skills/",
    "references/",
    "eval/",
    "adapters/",
    "!adapters/**/test/",
    "!adapters/**/__pycache__/",
    "!adapters/claude-code/ACTIVATION.md",
    "!assets/adapters-en/claude-code/ACTIVATION.md",
    "monitor/",
    "!monitor/*.test.cjs",
    "!monitor/pulse-write-scope.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json && chmod +x dist/index.js",
    "build:test": "tsc --build tsconfig.test.json",
    "test": "npm run build && npm run build:test && node scripts/casa-temporaria.cjs node --test dist-test/test/*.test.js",
    "test:ci": "npm run build && npm run build:test && node scripts/test-ci.js",
    "test:hermetica": "node scripts/test-lanes.cjs hermetica",
    "test:integracao": "node scripts/test-lanes.cjs integracao",
    "preparo:tsgo": "node scripts/preparo-tsgo.cjs",
    "ork": "node dist/index.js",
    "prepack": "npm run build && node scripts/preparar-pacote.js",
    "postpack": "node scripts/preparar-pacote.js --limpar"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "markdownlint-cli2": "^0.22.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "decode-named-character-reference": "1.3.0",
    "micromark": "4.0.2",
    "micromark-extension-gfm-table": "2.1.1",
    "micromark-util-decode-numeric-character-reference": "2.0.2",
    "smol-toml": "1.8.0",
    "typescript": "5.9.3",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  }
}
