  {
    "name": "npm-audit",
    "category": "dependency",
    "stacks": [
      "js"
    ],
    "image": "node@sha256:6f08a523443ddedf52941874c203475b0ad503e859ad70cb26ab8be9a517dbd5",
    "version": "26.12.0",
    "native": {
      "bin": "npm",
      "versionArgs": [
        "--version"
      ],
      "versionPattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "network": "default",
    "baseMode": "worktree",
    "timeoutMs": 300000,
    "severityMap": {
      "critical": "critical",
      "high": "high",
      "moderate": "medium",
      "low": "low",
      "info": "info"
    },
    "args": [
      "sh",
      "-c",
      "npm audit --package-lock-only --ignore-scripts --json > \"$1\"; rc=$?; [ $rc -le 1 ] || exit $rc",
      "sh",
      "{out}/npm-audit.json"
    ],
    "env": {
      "HOME": "/tmp",
      "npm_config_cache": "/tmp/npm-cache",
      "npm_config_update_notifier": "false"
    },
    "okExitCodes": [
      0
    ]
  },
  {
    "name": "pip-audit",
    "category": "dependency",
    "stacks": [
      "python"
    ],
    "image": "python@sha256:2699b90f4d562a22e2dd076c82f964032f64814204bff36d271a54ba4cc2c7e2",
    "version": "2.10.1",
    "native": {
      "bin": "pip-audit",
      "versionArgs": [
        "--version"
      ],
      "versionPattern": "\\b2\\.10\\.\\d+\\b"
    },
    "network": "default",
    "baseMode": "worktree",
    "timeoutMs": 600000,
    "install": [
      "pip-audit==2.10.1"
    ],
    "args": [
      "sh",
      "-c",
      "pip install --quiet --no-cache-dir --only-binary=:all: --target /tmp/pa {install}; reqs=\"\"; for f in requirements*.txt; do [ -f \"$f\" ] && reqs=\"$reqs -r $f\"; done; [ -n \"$reqs\" ] || { echo \"no-requirements-file\" >&2; exit 3; }; PYTHONPATH=/tmp/pa python -m pip_audit --no-deps --disable-pip --format json --output \"$1\" $reqs; rc=$?; [ $rc -le 1 ] || exit $rc",
      "sh",
      "{out}/pip-audit.json"
    ],
    "env": {
      "HOME": "/tmp",
      "PIP_DISABLE_PIP_VERSION_CHECK": "1"
    }
  },
