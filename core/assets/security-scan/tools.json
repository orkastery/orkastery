  {
    "name": "npm-audit",
    "category": "dependency",
    "stacks": [
      "js"
    ],
    "image": "node@sha256:6f08a523443ddedf52941874c203475b0ad503e859ad70cb26ab8be9a517dbd5",
    "version": "11.20.0",
    "native": {
      "bin": "npm",
      "versionArgs": [
        "--version"
      ],
      "versionPattern": "^11\\.\\d+\\.\\d+"
    },
    "network": "default",
    "baseMode": "worktree",
    "timeoutMs": 300000,
    "severityMap": {
      "critical": "critical",
      "high": "high",
      "moderate": "medium",
      "low": "low",
      "info": "info"
    },
    "args": [
      "sh",
      "-c",
      "cd \"$2\" && npm audit --package-lock-only --ignore-scripts --json > \"$1\"; rc=$?; [ $rc -le 1 ] || exit $rc; node -e 'const o=JSON.parse(require(\"fs\").readFileSync(process.argv[1],\"utf8\"));if(o.error||!o.vulnerabilities)process.exit(3)' \"$1\" || exit 3",
      "sh",
      "{out}/npm-audit.json",
      "{stackDir}"
    ],
    "env": {
      "HOME": "/tmp",
      "npm_config_cache": "/tmp/npm-cache",
      "npm_config_update_notifier": "false"
    },
    "expect": {
      "files": [
        "npm-audit.json"
      ],
      "shape": "object",
      "failIfKey": [
        "error"
      ],
      "requireKey": [
        "vulnerabilities"
      ]
    }
  },
  {
    "name": "pip-audit",
    "category": "dependency",
    "stacks": [
      "python"
    ],
    "image": "python@sha256:2699b90f4d562a22e2dd076c82f964032f64814204bff36d271a54ba4cc2c7e2",
    "version": "2.10.1",
    "native": {
      "bin": "pip-audit",
      "versionArgs": [
        "--version"
      ],
      "versionPattern": "\\b2\\.10\\.\\d+\\b"
    },
    "severityMap": {
      "*": "high"
    },
    "network": "default",
    "baseMode": "worktree",
    "timeoutMs": 600000,
    "install": [
      "pip-audit==2.10.1"
    ],
    "args": [
      "sh",
      "-c",
      "cd \"$2\" || exit 3; pip install --quiet --no-cache-dir --only-binary=:all: --target /tmp/pa {install} || exit 3; reqs=\"\"; for f in requirements*.txt; do [ -f \"$f\" ] && reqs=\"$reqs -r $f\"; done; [ -n \"$reqs\" ] || { echo \"no-requirements-file\" >&2; exit 3; }; PYTHONPATH=/tmp/pa python -m pip_audit --no-deps --disable-pip --format json --output \"$1\" $reqs; rc=$?; [ $rc -le 1 ] || exit $rc; python -c 'import json,sys;sys.exit(0 if \"dependencies\" in json.load(open(sys.argv[1])) else 3)' \"$1\" || exit 3",
      "sh",
      "{out}/pip-audit.json",
      "{stackDir}"
    ],
    "env": {
      "HOME": "/tmp",
      "PIP_DISABLE_PIP_VERSION_CHECK": "1"
    },
    "expect": {
      "files": [
        "pip-audit.json"
      ],
      "shape": "object",
      "requireKey": [
        "dependencies"
      ]
    }
  },
